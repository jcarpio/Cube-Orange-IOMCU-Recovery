--- a/ROMFS/px4fmu_common/init.d/rcS
+++ b/ROMFS/px4fmu_common/init.d/rcS
@@ -384,9 +384,10 @@ else
 	fi
 
 	#
-	# px4io
+	# PX4IO disabled during Cube Orange IOMCU diagnostics (Build C).
+	# Do not check CRC, update firmware or start the normal driver.
 	#
-	if px4io supported
+	if false
 	then
 	# Check if PX4IO present and update firmware if needed.
 		if [ -f $IOFW ]
@@ -421,10 +422,8 @@ else
 
 	# Heater driver for temperature regulated IMUs.
 	# The heater needs to start after px4io.
-	if param compare -s SENS_EN_THERMAL 1
-	then
-		heater start
-	fi
+	# Build C: disable automatic heater driver startup.
+	# IOMCU thermal hardware state remains unknown.
 
 
 	#
diff --git a/boards/cubepilot/cubeorange/rover.px4board b/boards/cubepilot/cubeorange/rover.px4board
index ee14c06919..aa96462b5b 100644
--- a/boards/cubepilot/cubeorange/rover.px4board
+++ b/boards/cubepilot/cubeorange/rover.px4board
@@ -29,7 +29,7 @@ CONFIG_DRIVERS_PCA9685_PWM_OUT=y
 CONFIG_DRIVERS_POWER_MONITOR_INA226=y
 CONFIG_DRIVERS_PWM_INPUT=y
 CONFIG_DRIVERS_PWM_OUT=y
-# CONFIG_DRIVERS_PX4IO is not set
+CONFIG_DRIVERS_PX4IO=y
 CONFIG_DRIVERS_HEATER=y
 CONFIG_DRIVERS_SMART_BATTERY_BATMON=y
